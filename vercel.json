{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.wealthsproutkids.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wealthsproutkids.com"
        }
      ],
      "destination": "https://www.wealthsproutkids.com/:path*",
      "permanent": true
    }
  ],
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ]
}
